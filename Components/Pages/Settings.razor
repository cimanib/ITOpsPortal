@page "/settings"
@inject PortalApiClient Api

<PageTitle>Settings</PageTitle>
<h1 class="page-title">Settings</h1>
<p class="page-sub">Portal-wide preferences.</p>

@if (error is not null)

{
    <div class="alert-error" role="alert"><span>@error</span> <button type="button" class="link" @onclick="() => error = null">Dismiss</button></div>
}

<section class="card narrow">
    <h2>General</h2>
    @if (model is null)

    {
        <p class="muted">Loading...</p>
    }

    else

    {
        <EditForm Model="model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="form-grid">
                <label class="wide">Portal Name<InputText @bind-Value="model.PortalName" /><ValidationMessage For="() => model.PortalName" /></label>
                <label class="wide">Notification Email<InputText type="email" @bind-Value="model.NotificationEmail" /><ValidationMessage For="() => model.NotificationEmail" /></label>
                <label>SLA Compliance shown on dashboard (%)<InputNumber @bind-Value="model.SlaCompliance" /><ValidationMessage For="() => model.SlaCompliance" /></label>
                <label class="check"><InputCheckbox @bind-Value="model.EmailAlerts" /> Send alert emails</label>
            </div>
            <div class="actions">
                <button type="button" class="btn" @onclick="LoadAsync">Cancel</button>
                <button type="submit" class="btn primary" disabled="@busy">Save</button>
            </div>
            @if (saved)
            {
                <p class="ok" role="status">Settings saved.</p>
            }
        </EditForm>
    }
</section>

@code {
    private PortalSettings? model;

    private string? error;

    private bool saved, busy;



    protected override Task OnInitializedAsync() => LoadAsync();



    private async Task LoadAsync()

    {

        saved = false;

        try { model = await Api.GetSettingsAsync(); }

        catch (ApiException ex) { error = ex.Message; model ??= new(); }

    }



    private async Task SaveAsync()

    {

        busy = true; error = null;

        try { model = await Api.SaveSettingsAsync(model!); saved = true; }

        catch (ApiException ex) { error = ex.Message; saved = false; }

        finally { busy = false; }

    }
}
